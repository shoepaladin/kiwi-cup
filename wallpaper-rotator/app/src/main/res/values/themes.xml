<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WallpaperRotator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Surface and Background -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Material 3 style attributes often used in newer templates/code -->
        <item name="colorSurfaceVariant">#EEEEEE</item>
        <item name="colorOnSurfaceVariant">#666666</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Customize your theme here. -->
    </style>
</resources>
